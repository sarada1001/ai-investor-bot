# ============================================================
# 機密情報 — 絶対にコミットしない
# ============================================================
.env
.env.*
# サンプルファイルは許可
!.env.example

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.egg
.eggs/

# 仮想環境
.venv/
venv/
env/
ENV/

# ============================================================
# データベース・ローカルデータ（重い・機密）
# ============================================================
chroma_db_saved/
chroma_db/
*.sqlite3
*.db

# BBS セッションログ（実行ごとに生成される一時ファイル）
bbs/

# portfolio.json の日次バックアップ（保有ポジションそのもの。ホスト固有の状態）
# ディレクトリ自体は Docker の volume マウント先として必要なので .gitkeep で残す
backups/*
!backups/.gitkeep

# Docker スモークテスト用の一時ディレクトリ（docs/DOCKER.md 8章）
.smoke/

# 実行時状態ファイル（ローカル/本番の実行環境に依存、頻繁に更新されるため追跡しない）
data/portfolio.json
data/agent_status.json
data/circuit_breaker_state.json
data/trade_guard_state.json
data/training/open_positions_index.json
data/training/training_data.jsonl
data/training/training_data_prod.jsonl
# health_check の自己申告記録。ホストごとに独立した値でなければならない
# （git 経由で共有されると、開発機の実行時刻が本番の「前回実行」を上書きし、
#  本番で health_check が止まっていても検知できなくなる）
data/health_last_run.json

# ライブ取引認証状態（24h有効期限付き・コミット不要）
data/live_trading_enabled.json

# 決算PDF・ZIPなど（著作権・容量の観点から除外）
unzipped_docs/
*.zip
*.pdf

# ============================================================
# OS・エディタのシステムファイル
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# JetBrains (PyCharm, IntelliJ など)
.idea/
*.iml
*.iws

# VS Code
.vscode/
*.code-workspace

# Vim
*.swp
*.swo
*~

# ============================================================
# ログ・一時ファイル
# ============================================================
*.log
bot_log.txt
*.tmp
*.bak
.cache/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
*.ipynb

# ============================================================
# その他
# ============================================================
# Pickle バイナリ（再現性のないバイナリ）
*.p
*.pkl
*.pickle
latest_summary.md

# 研究・分析の生成物（実行すれば再生成可能・本番と開発機で必ず競合する）
data/analytics/
data/research/
data/evaluation/agent_status_history.jsonl
