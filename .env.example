# ============================================================
# 環境変数テンプレート
# このファイルをコピーして .env を作成してください。
# .env はGitにコミットしないでください（.gitignoreで除外済み）。
# ============================================================

# Google AI Studio (Gemini)
# 取得先: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ── LLM バックエンド制御（skills/llm_factory.py） ──────────────────────
# Ollama サーバー URL（デフォルト: localhost）
OLLAMA_BASE_URL=http://localhost:11434
# Ollama モデル名（デフォルト: llama3.1）
OLLAMA_MODEL=llama3.1
# Gemini を強制使用（Ollama を無視）: true / false
FORCE_GEMINI=false
# Gemini フォールバックを完全封鎖（課金ゼロ保証）: true / false
DISABLE_GEMINI=false
# Gemini モデル名（フォールバック時のデフォルト）
GEMINI_MODEL=gemini-2.0-flash

# LINE Messaging API
# 取得先: https://developers.line.biz/ → Messaging API チャネル
LINE_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here
