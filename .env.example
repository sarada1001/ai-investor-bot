# ============================================================
# 環境変数テンプレート
# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
# .env は .gitignore で除外済みのため Git にコミットされません。
# ============================================================

# ── Alpaca 証券 API（発注・口座管理） ─────────────────────────────────
# 取得先: https://app.alpaca.markets/brokerage/dashboard/overview
#
# 正式名称（Alpaca SDK 標準、tools/alpaca_client.py が読み込む変数名）:
APCA_API_KEY_ID=your_alpaca_api_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here
#
# エイリアス（上記が未設定の場合にフォールバックとして使用される）:
# ALPACA_API_KEY=your_alpaca_api_key_here
# ALPACA_SECRET_KEY=your_alpaca_secret_key_here
#
# True = ペーパー取引（テスト用）/ False = 本番取引
# 注意: 本番取引を有効にするには別途 python main.py --enable-live が必要
ALPACA_PAPER_TRADING=True

# ── Google AI Studio (Gemini) ────────────────────────────────────────
# 取得先: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ── LLM バックエンド制御（skills/llm_factory.py） ──────────────────────
# Ollama サーバー URL（デフォルト: localhost）
OLLAMA_BASE_URL=http://localhost:11434
# Ollama モデル名（デフォルト: llama3.1）
OLLAMA_MODEL=llama3.1
# Gemini を強制使用（Ollama を無視）: true / false
FORCE_GEMINI=false
# Gemini フォールバックを完全封鎖（課金ゼロ保証）: true / false
DISABLE_GEMINI=false
# Gemini モデル名。Gemini を使う全経路（ExitAgent / RAG / CriticAgent /
# server_librarian / preflight）がこの1箇所を参照する。
# Google がモデルを廃止すると 429 RESOURCE_EXHAUSTED (limit: 0) になり
# リトライでは回復しないため、廃止告知が出たらここを更新すること。
GEMINI_MODEL=gemini-2.5-flash

# ── SNS センチメント制御（skills/social_monitor.py） ────────────────────────
# false (デフォルト / 本番): SNS API 未接続のため中立 0.0 を返す（安全側設定）
# true  (開発/テスト)      : モック Reddit 投稿を LLM で評価する
SOCIAL_USE_MOCK=false

# LINE Messaging API
# 取得先: https://developers.line.biz/ → Messaging API チャネル
LINE_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here
